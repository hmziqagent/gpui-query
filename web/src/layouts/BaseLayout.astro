---
// App shell for marketing/blog/legal pages. Mirrors web/src/routes/__root.tsx:
// HTML shell, no-flash theme bootstrap, global stylesheet, navbar island,
// footer, Firebase Analytics, and explicit per-page metadata.
//
// Docs pages are owned by Starlight (its own layout) and are NOT wrapped here.
import "../styles.css";
import Navbar from "../components/navbar.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/search-dialog.astro";
import FirebaseAnalytics from "../components/firebase-analytics.astro";

export interface Props {
  /** Full <title> text (include the "- gpui-query" suffix at the call site). */
  title: string;
  description?: string;
  /** Canonical path, e.g. "/", "/blog", "/privacy". Joined to the site URL. */
  canonicalPath: string;
  /** OG image path (default: the homepage brand card). */
  image?: string;
  noindex?: boolean;
  ogType?: string;
  jsonLd?: object | object[];
  /** Emit .md/.txt rel=alternate links (default true; false for the 404). */
  alts?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image = "/og-image.png",
  noindex = false,
  ogType = "website",
  jsonLd,
  alts = true,
} = Astro.props;

const SITE = "https://gpui-query.freeoxide.com";
const canonical = new URL(canonicalPath, SITE).href;
const ogImage = new URL(image, SITE).href;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Token-light alternates: every page is also served as `.md` and `.txt` at the
// same path (root -> /index.{md,txt}). Advertise them so crawlers/agents that
// inspect the head can find the small copy without guessing the convention.
const altBase = canonicalPath.replace(/\/+$/, "");
const altHref = (ext: string) => `${altBase === "" ? "/index" : altBase}${ext}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9AE600" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    {/* Token-light alternates (markdown + plain text) for AI agents. */}
    {alts && <link rel="alternate" type="text/markdown" href={altHref(".md")} />}
    {alts && <link rel="alternate" type="text/plain" href={altHref(".txt")} />}

    {/* OpenGraph */}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="gpui-query" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {jsonLdArray.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    {/* No-flash theme bootstrap: same contract as the old __root.tsx — the
        marketing app keys dark mode off a `.dark` class on <html> and a
        `theme` localStorage entry (docs/Starlight use `data-theme` instead). */}
    <script is:inline>
      (function(){try{var t=localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.classList.add('dark');document.querySelector('meta[name=theme-color]')?.setAttribute('content','#0C1222')}}catch(e){}})()
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <div id="app" class="flex min-h-screen flex-col">
      <Navbar />
      <main id="main-content" class="flex-1" data-pagefind-body>
        <slot />
      </main>
      <Footer />
    </div>
    <SearchDialog />
    <FirebaseAnalytics />

    {/* Basecoat interactive-component runtime (accordion, command, drawer,
        dropdown-menu, popover, select, tabs, ...). Auto-initializes on load;
        no init() call needed. Processed/bundled by Vite, deferred (type=module). */}
    <script>
      import "basecoat-css/all";
    </script>

    {/* Scroll-reveal — global vanilla replacement for the old useScrollReveal
        hook. Adds .js-reveal to <html> (enabling the [data-reveal] hidden
        state defined in styles.css) and reveals elements as they enter view.
        Progressive enhancement: content is visible without JS. */}
    <script>
      const enable = () => {
        const root = document.documentElement;
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!els.length) return;
        root.classList.add("js-reveal");
        if (prefersReduced) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
        );
        els.forEach((el) => observer.observe(el));
      };
      enable();
    </script>
  </body>
</html>
