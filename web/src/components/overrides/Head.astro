---
// Starlight <Head> override.
//
// Why this exists: under `build.format: "file"` (kept so output stays flat
// `foo.html`, matching the no-trailing-slash deploy scheme), Starlight's
// canonical + og:url carry a trailing `.html`. See
// node_modules/@astrojs/starlight/utils/canonical.ts — `formatCanonical()`
// returns the href unchanged for file format — and utils/head.ts builds it
// from `context.url.pathname`, which includes `.html` for file-format pages.
//
// The site serves these pages at the extensionless URL (Cloudflare Pages
// `auto-trailing-slash`), and `@astrojs/sitemap` already advertises the
// extensionless form. Stripping `.html` from just `canonical` and `og:url`
// keeps the head consistent with the sitemap and the rest of the site.

const head = Astro.locals.starlightRoute.head.map((entry) => {
	const attrs = entry.attrs ?? {};
	// Only touch <link rel="canonical" href="…"> and <meta property="og:url" content="…">.
	if (attrs.rel !== "canonical" && attrs.property !== "og:url") return entry;
	const key = "href" in attrs ? "href" : "content";
	const value = attrs[key];
	if (typeof value !== "string") return entry;
	return { ...entry, attrs: { ...attrs, [key]: value.replace(/\.html(?=[?#]|$)/, "") } };
});

// Branded icon links — Starlight only injects the favicon.ico <link> from its
// `favicon` config (which is already in `head` above); add the vector +
// apple-touch variants so docs pages match the marketing <head> (see
// BaseLayout.astro). No dedup risk: BaseLayout never wraps docs pages.
head.push(
	{ tag: "link", attrs: { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" } },
	{ tag: "link", attrs: { rel: "apple-touch-icon", href: "/apple-touch-icon.png" } },
);

// Token-light alternates: advertise the per-page `.md` / `.txt` copies (root of
// the docs section -> /docs.md; nested pages -> /docs/{...}.md) so agents
// inspecting the head can find them. See scripts/generate-page-alts.ts.
const altPath = Astro.url.pathname.replace(/\/+$/, "");
const altBase = altPath === "" ? "/index" : altPath;
head.push(
	{ tag: "link", attrs: { rel: "alternate", type: "text/markdown", href: `${altBase}.md` } },
	{ tag: "link", attrs: { rel: "alternate", type: "text/plain", href: `${altBase}.txt` } },
);
---
{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
