---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalPage from "../components/LegalPage.astro";
import LegalSection from "../components/LegalSection.astro";
import { getLegalDoc } from "../lib/legal-content";
import { renderInlineMarkdown } from "../lib/inline-md";

// Legal copy lives once in ../lib/legal-content (shared with the /privacy.md
// and /privacy.txt alt-format generator). Here we only render it to HTML.
const doc = getLegalDoc("privacy");
const title = `${doc.title} - gpui-query`;
const description = doc.description;
---
<BaseLayout title={title} description={description} canonicalPath="/privacy">
  <LegalPage title={doc.title} description={doc.intro} updatedAt={doc.updatedAt}>
    {doc.sections.map((section) => (
      <LegalSection title={section.title}>
        {section.paragraphs.map((p) => (
          <p set:html={renderInlineMarkdown(p)} />
        ))}
      </LegalSection>
    ))}
  </LegalPage>
</BaseLayout>
